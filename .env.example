# Copy to .env and fill in. Never commit .env.

# Outputs
YOUTUBE_STREAM_KEY=
TWITCH_STREAM_KEY=

# Chat
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Models in the cloud
GROQ_API_KEY=
SARVAM_API_KEY=

# Engine
STREAM_DELAY_SECONDS=4
INGEST_PORT_SRT=8890
INGEST_PORT_RTMP=1935

# API and app (local only)
SECRET_KEY=
REQUIRE_AUTH=true
STREAMSARTHI_PROFILE=dev
API_PORT=8000
WEB_PORT=3000

# Hugging Face token (demo profile: gated IndicTrans2 model only)
HF_TOKEN=

# Phone/OBS publish login for the ingest (random per run if left empty; set both to keep a stable pairing)
INGEST_PUBLISH_USER=
INGEST_PUBLISH_PASSWORD=
